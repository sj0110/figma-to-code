{
    "compilerOptions": {
        "target": "ES6",
        "module": "commonjs",
        "lib": [
            "ES2017"
        ],
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "outDir": "./dist",
        "typeRoots": [
            "./node_modules/@types",
            "./node_modules/@figma"
        ]
    },
    "include": [
        "code.ts"
    ]
}